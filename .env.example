# Copy to Netlify → Site configuration → Environment variables. Never commit real values.
# Step-by-step: SETUP.ru.md · check what's missing: GET /api/health

# Sign in with X (OAuth 2.0 Client ID / Secret, Web App type)
X_CLIENT_ID=
X_CLIENT_SECRET=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# https://forks.wiki on the live site; http://127.0.0.1:5173 locally
SITE_URL=
# Optional: reject X accounts younger than this many days
X_MIN_ACCOUNT_AGE_DAYS=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub: every point on a tree is checked here (fine-grained token, public repositories read-only)
GITHUB_TOKEN=

# upstream: DeepSeek by default (any OpenAI-compatible chat completions API works)
FORKS_LLM_KEY=
# default https://api.deepseek.com/chat/completions
FORKS_LLM_URL=
# default deepseek-flash (thinking is switched off on DeepSeek)
FORKS_LLM_MODEL=
# Optional: new (uncached) traces per IP per minute, default 8
FORKS_TRACES_PER_MIN=
