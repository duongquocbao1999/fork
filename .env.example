# Copy to Netlify → Site configuration → Environment variables. Never commit real values.
# Step-by-step: SETUP.ru.md · check what's missing: GET /api/health

# Sign in with X (OAuth 2.0 Client ID / Secret, Web App type)
X_CLIENT_ID=
X_CLIENT_SECRET=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# https://forks.wiki on the live site; http://127.0.0.1:5173 locally
SITE_URL=
# Optional: reject X accounts younger than this many days
X_MIN_ACCOUNT_AGE_DAYS=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub: every point on a tree is checked here (fine-grained token, public repositories read-only)
GITHUB_TOKEN=
# Optional: "connect GitHub", an optional trial (+3,000). A GitHub OAuth App (Settings → Developer settings →
# OAuth Apps), Authorization callback URL exactly https://forks.wiki/auth/github/callback. Needs 0005_github.sql.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# upstream: DeepSeek by default (any OpenAI-compatible chat completions API works)
FORKS_LLM_KEY=
# default https://api.deepseek.com/chat/completions
FORKS_LLM_URL=
# default deepseek-flash (thinking is switched off on DeepSeek)
FORKS_LLM_MODEL=
# Optional: new (uncached) traces per IP per minute, default 8
FORKS_TRACES_PER_MIN=

# Coins on repositories (pump.fun, Solana mainnet). Also set launch.treasury in src/config.js.
# A mainnet RPC with your key, e.g. https://mainnet.helius-rpc.com/?api-key=… (secret: server only)
SOLANA_RPC_URL=
# Optional: a Jito block engine near the functions, default https://mainnet.block-engine.jito.wtf
JITO_URL=
# The coin's logo + metadata go to public IPFS through Pinata (pump.fun no longer takes uploads at /api/ipfs).
# app.pinata.cloud → API Keys → New Key (Files: Write) → the JWT. Secret: server only. Needed for launches.
PINATA_JWT=
# Optional, only without PINATA_JWT: another uploader that takes pump.fun's old form and answers { metadataUri }
PUMP_IPFS_URL=
# Optional: your own Pinata gateway (https://<name>.mypinata.cloud), tried first when /api/ipfs/<cid> shows a logo
PINATA_GATEWAY=
# Optional: launch builds per IP per minute, default 6
LAUNCH_BUILDS_PER_MIN=

# The terminal (market.mjs) uses SOLANA_RPC_URL too. Jupiter, for trades off a pump.fun curve:
# a free key from developers.jup.ag/portal lifts the keyless limit (0.5 requests a second for the whole site)
JUP_API_KEY=
# Optional: default https://api.jup.ag/swap/v2
JUP_URL=
# forks' 0.5% on Jupiter trades: the address of forks' Jupiter referral account (Ultra referral project),
# made once at referral.jup.ag with the treasury wallet, with token accounts for SOL and USDC. Public, not a
# secret. Without it Jupiter trades carry no forks fee; trades on a pump.fun curve take it from launch.treasury anyway.
JUP_REFERRAL_ACCOUNT=
